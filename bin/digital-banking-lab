        exit(0);
    } catch (InvalidArgumentException $error) {
        fwrite(STDERR, $error->getMessage() . "\n");
        exit(1);
    }
}
if ($command === 'vendor-rest') {
    $memberIdentifier = $argv[2] ?? null;
    if ($memberIdentifier === null) { fwrite(STDERR, "A member identifier is required.\n"); exit(1); }
    $scenario = 'normal';
    foreach (array_slice($argv, 3) as $argument) {
        if (str_starts_with($argument, '--scenario=')) $scenario = substr($argument, strlen('--scenario='));
    }
    try {
        $memberId = new MemberId($memberIdentifier);
        $identities = VendorIdentityMap::laboratory();
        $customerKey = $identities->northstarCustomerFor($memberId);
        $http = new DeterministicHttpClient($scenario, dirname(__DIR__) . '/fixtures/northstar');
        $client = new NorthstarRestClient($http, 'https://northstar.invalid');
        $member = (new NorthstarDigitalBankingAdapter($client, $identities, new NorthstarTranslator()))->findMember($memberId);
        $request = $http->requests()[0];
        $total = array_reduce($member->accounts, fn ($sum, $account) => $sum->add($account->balance), \Harbor\DigitalBankingLab\Domain\Member\Money::usd(0));
        echo "NORTHSTAR REST DIAGNOSTIC — NOT MEMBER-FACING OUTPUT\n\n";
        echo "Harbor Member: {$memberId->value}\nVendor Customer: {$customerKey->value}\n";
        echo "Request: {$request['method']} " . parse_url($request['url'], PHP_URL_PATH) . "\nHTTP Status: 200\n";
        echo "Decoded Vendor Customer: {$customerKey->value}\nTranslated Harbor Member: {$member->name}\nTotal displayed balance: {$total->format()}\n";
        exit(0);
    } catch (NorthstarCustomerNotFound|NorthstarHttpFailure|NorthstarResponseDecodingFailure|NorthstarTransportFailure|UnknownVendorIdentity|VendorTranslationException|InvalidArgumentException $error) {
        fwrite(STDERR, get_class($error) . ': ' . $error->getMessage() . "\n");
        exit(1);
    }
}
if (in_array($command, ['vendor-member', 'vendor-map', 'compare-member'], true)) {
    $memberIdentifier = $argv[2] ?? null;
    if ($memberIdentifier === null) {
        fwrite(STDERR, "A member identifier is required.\n");
        exit(1);
    }
    try {
        $memberId = new MemberId($memberIdentifier);
        $identities = VendorIdentityMap::laboratory();
        if ($command === 'vendor-map') {
            echo "LABORATORY IDENTITY MAP — NOT MEMBER-FACING OUTPUT\n\n";
            echo "Harbor Member: {$memberId->value}\nNorthstar Customer: {$identities->northstarCustomerFor($memberId)->value}\n";
            foreach ($identities->accounts() as [$accountId, $productKey]) {
                echo "\nHarbor Account: {$accountId->value}\nNorthstar Product: {$productKey->value}\n";
            }
            exit(0);
        }
        $scenario = $argv[3] ?? 'normal';
        $gateway = new NorthstarDigitalBankingAdapter(new DeterministicNorthstarClient($scenario), $identities, new NorthstarTranslator());
        $vendorMember = $gateway->findMember($memberId);
        if ($command === 'vendor-member') {
            echo (new VendorMemberRenderer())->render($vendorMember);
            exit(0);
        }
        $direct = MemberFixtureFactory::find($memberId);
        $equivalent = (new MemberDomainComparator())->equivalent($direct, $vendorMember);
        echo "Direct Harbor fixture: PASS\nNorthstar translation: PASS\nEquivalent Harbor domain state: " . ($equivalent ? 'YES' : 'NO') . "\n";
        exit($equivalent ? 0 : 1);
    } catch (InvalidArgumentException|UnknownVendorIdentity|VendorTranslationException $error) {
        fwrite(STDERR, $error->getMessage() . "\n");
        exit(1);
    }
}
if ($command === 'laboratory' || $command === 'determinism') {
    $scenarioIdentifier = $argv[2] ?? null;
    if ($scenarioIdentifier === null) {
        fwrite(STDERR, "A laboratory scenario is required.\n");
        exit(1);
    }
    try {
        $laboratoryRenderer = new LaboratoryRenderer();
        if ($command === 'laboratory') {
            echo $laboratoryRenderer->render(LaboratoryFixtureFactory::create($scenarioIdentifier));
            exit(0);
        }
        $first = $laboratoryRenderer->render(LaboratoryFixtureFactory::create($scenarioIdentifier));
        $second = $laboratoryRenderer->render(LaboratoryFixtureFactory::create($scenarioIdentifier));
        $firstHash = hash('sha256', $first);
        $secondHash = hash('sha256', $second);
        echo "Scenario: {$scenarioIdentifier}\nRun 1 hash: {$firstHash}\nRun 2 hash: {$secondHash}\nDeterministic: " . ($first === $second ? 'YES' : 'NO') . "\n";
        exit($first === $second ? 0 : 1);
    } catch (InvalidArgumentException $error) {
        fwrite(STDERR, $error->getMessage() . "\n");
        exit(1);
    }
}

fwrite(STDERR, "Usage: ./bin/digital-banking-lab <ecosystem|...|db-members|account-activity ACCOUNT_ID|inactive-members --days=180|sql-example inactive-members|sql-pitfall inactivity|explain inactive-members>\n");
exit(1);
