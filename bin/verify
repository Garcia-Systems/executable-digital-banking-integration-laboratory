echo '== Full-stack debug laboratory suite =='; php tests/Debug/run.php
echo '== Delivery workflow suite =='; php tests/Delivery/run.php
echo '== Member Web typecheck =='; (cd apps/member-web && npm run typecheck)
echo '== Member Web tests =='; (cd apps/member-web && npm test)
